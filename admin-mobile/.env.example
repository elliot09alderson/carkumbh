# Copy to .env and restart Expo (Metro picks up EXPO_PUBLIC_* at startup).
#
# Deployed backend (default when no .env is set):
# EXPO_PUBLIC_API_URL=https://toransir.com/api
#
# Android emulator → API on your Mac (localhost from the host):
# EXPO_PUBLIC_API_URL=http://10.0.2.2:5000/api
#
# Physical phone on same Wi-Fi as your Mac:
# EXPO_PUBLIC_API_URL=http://192.168.x.x:5000/api
